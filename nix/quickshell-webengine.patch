diff -ruN a/src/launch/webengine.cpp b/src/launch/webengine.cpp
--- a/src/launch/webengine.cpp	1970-01-01 01:00:00.000000000 +0100
+++ b/src/launch/webengine.cpp	2026-11-23 17:19:15.077785091 +0100
@@ -0,0 +1,128 @@
+#include "webengine.hpp"
+#include <cstring>
+#include <utility>
+
+#include <qbytearray.h>
+#include <qmutex.h>
+#include <qobject.h>
+#include <qquickwebengineprofile.h>
+#include <qurl.h>
+#include <qwebengineurlrequestinfo.h>
+#include <qwebengineurlrequestinterceptor.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+namespace qs::launch {
+
+namespace {
+
+// One line per request, "<type>\t<url>\t<page>\n", answered by "1\n" (block) or "0\n".
+// A service that is not there or does not answer in time lets the request through.
+class RequestFilter: public QWebEngineUrlRequestInterceptor {
+public:
+	explicit RequestFilter(QByteArray socketPath, QObject* parent)
+	    : QWebEngineUrlRequestInterceptor(parent)
+	    , socketPath(std::move(socketPath)) {}
+
+	~RequestFilter() override {
+		if (this->fd >= 0) ::close(this->fd);
+	}
+
+	Q_DISABLE_COPY_MOVE(RequestFilter);
+
+	void interceptRequest(QWebEngineUrlRequestInfo& info) override {
+		auto line = QByteArray(RequestFilter::typeName(info.resourceType()));
+		line += '\t';
+		line += info.requestUrl().toEncoded();
+		line += '\t';
+		line += info.firstPartyUrl().toEncoded();
+		line += '\n';
+
+		auto locker = QMutexLocker(&this->mutex);
+		if (this->ask(line)) info.block(true);
+	}
+
+private:
+	static const char* typeName(QWebEngineUrlRequestInfo::ResourceType type) {
+		switch (type) {
+		case QWebEngineUrlRequestInfo::ResourceTypeMainFrame: return "main_frame";
+		case QWebEngineUrlRequestInfo::ResourceTypeSubFrame: return "sub_frame";
+		case QWebEngineUrlRequestInfo::ResourceTypeStylesheet: return "stylesheet";
+		case QWebEngineUrlRequestInfo::ResourceTypeScript: return "script";
+		case QWebEngineUrlRequestInfo::ResourceTypeImage: return "image";
+		case QWebEngineUrlRequestInfo::ResourceTypeFontResource: return "font";
+		case QWebEngineUrlRequestInfo::ResourceTypeObject: return "object";
+		case QWebEngineUrlRequestInfo::ResourceTypeMedia: return "media";
+		case QWebEngineUrlRequestInfo::ResourceTypeXhr: return "xmlhttprequest";
+		case QWebEngineUrlRequestInfo::ResourceTypePing: return "ping";
+		case QWebEngineUrlRequestInfo::ResourceTypeCspReport: return "csp_report";
+		case QWebEngineUrlRequestInfo::ResourceTypeWebSocket: return "websocket";
+		default: return "other";
+		}
+	}
+
+	bool open() {
+		this->fd = ::socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+		if (this->fd < 0) return false;
+
+		// A page waits for this answer: a service that hangs must not hang the browser.
+		auto timeout = timeval {.tv_sec = 0, .tv_usec = 100000};
+		::setsockopt(this->fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+		::setsockopt(this->fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout));
+
+		auto address = sockaddr_un {};
+		address.sun_family = AF_UNIX;
+		if (static_cast<size_t>(this->socketPath.size()) >= sizeof(address.sun_path)) {
+			this->drop();
+			return false;
+		}
+		memcpy(address.sun_path, this->socketPath.constData(), this->socketPath.size());
+
+		// NOLINTNEXTLINE(cppcoreguidelines-pro-type-reinterpret-cast)
+		if (::connect(this->fd, reinterpret_cast<sockaddr*>(&address), sizeof(address)) != 0) {
+			this->drop();
+			return false;
+		}
+
+		return true;
+	}
+
+	void drop() {
+		if (this->fd >= 0) ::close(this->fd);
+		this->fd = -1;
+	}
+
+	bool ask(const QByteArray& line) {
+		// Twice: the service may have been started again since the last request.
+		for (auto attempt = 0; attempt < 2; attempt++) {
+			if (this->fd < 0 && !this->open()) return false;
+
+			auto sent = ::send(this->fd, line.constData(), line.size(), MSG_NOSIGNAL);
+			if (sent == line.size()) {
+				char answer[2] = {};
+				auto got = ::recv(this->fd, answer, sizeof(answer), MSG_WAITALL);
+				if (got == sizeof(answer)) return answer[0] == '1';
+			}
+
+			this->drop();
+		}
+
+		return false;
+	}
+
+	QByteArray socketPath;
+	QMutex mutex;
+	int fd = -1;
+};
+
+} // namespace
+
+void installRequestFilter(const QByteArray& socketPath, QObject* parent) {
+	QQuickWebEngineProfile::defaultProfile()->setUrlRequestInterceptor(
+	    new RequestFilter(socketPath, parent)
+	);
+}
+
+} // namespace qs::launch
