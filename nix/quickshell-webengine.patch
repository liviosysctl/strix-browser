+#pragma once
+
+#include <qbytearray.h>
+#include <qobject.h>
+
+namespace qs::launch {
+
+/// Asks the service behind the Unix socket at `socketPath` about every request the default
+/// profile of Qt WebEngine makes, and blocks the ones it says to.
+void installRequestFilter(const QByteArray& socketPath, QObject* parent);
+
+} // namespace qs::launch
